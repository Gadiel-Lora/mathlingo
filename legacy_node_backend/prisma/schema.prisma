generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GradeStage {
  PRIMARY
  SECONDARY
  PRE_UNIVERSITY
}

enum LearningPathType {
  GRADE
  AUTONOMOUS
  HYBRID
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum SkillDomain {
  ARITHMETIC
  ALGEBRA
  GEOMETRY
  TRIGONOMETRY
  STATISTICS
  CALCULUS
  LOGIC
}

enum LessonStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  MASTERED
}

enum ProblemSource {
  SEEDED
  GENERATED
  IMPORTED
}

enum TutorProvider {
  N8N
  OLLAMA
  LOCAL
}

enum TutorInterventionLevel {
  SUBTLE
  DIRECTIONAL
  CONCEPTUAL
  DIAGNOSTIC
}

enum PedagogicalEventType {
  ANSWER_SUBMITTED
  SKILL_FAILED_TWICE
  HINT_REQUESTED
  LESSON_COMPLETED
  MASTERY_UPDATED
  DIAGNOSTIC_TRIGGER
  TUTOR_FEEDBACK
}

enum N8nDeliveryStatus {
  PENDING
  DISPATCHED
  FAILED
  ACKNOWLEDGED
}

model Grade {
  id              String              @id
  code            String              @unique
  name            String              @unique
  order           Int                 @unique
  stage           GradeStage
  levelName       String
  foundationStyle String              @default("singapore-finland")
  isPreUniversity Boolean             @default(false)

  users         User[]
  skills        Skill[]
  lessons       Lesson[]
  bimesters     CurriculumBimester[]
  learningPaths LearningPath[]

  @@index([stage, order])
}

model CurriculumBimester {
  id          String @id
  gradeId     String
  order       Int
  title       String
  description String

  grade Grade            @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  units CurriculumUnit[]

  @@unique([gradeId, order])
  @@index([gradeId])
}

model CurriculumUnit {
  id          String @id
  bimesterId  String
  order       Int
  title       String
  description String
  theme       String

  bimester CurriculumBimester @relation(fields: [bimesterId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@unique([bimesterId, order])
  @@index([bimesterId])
}

model Lesson {
  id                String @id
  code              String @unique
  unitId            String
  gradeId           String
  order             Int
  title             String
  slug              String @unique
  description       String
  domain            SkillDomain
  difficulty        Int
  estimatedMinutes  Int
  xpReward          Int      @default(0)
  isGateLesson      Boolean  @default(false)
  isCapstone        Boolean  @default(false)
  learningObjective String
  metadata          Json?
  createdAt         DateTime @default(now())

  grade              Grade              @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  unit               CurriculumUnit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  lessonSkills       LessonSkill[]
  userStates         UserLessonState[]
  problems           Problem[]
  attempts           ProblemAttempt[]
  tutorConversations TutorConversation[]
  tutorInterventions TutorIntervention[]
  pedagogicalEvents  PedagogicalEvent[]
  assignedTasks      AssignedTask[]
  skillSequences     SkillSequence[]
  primarySkills      Skill[]

  @@unique([unitId, order])
  @@index([gradeId])
  @@index([domain])
}

model LearningPath {
  id           String           @id
  slug         String           @unique
  name         String
  description  String
  type         LearningPathType
  isAutonomous Boolean
  isDefault    Boolean          @default(false)
  gradeId      String?
  subjectId    String?

  grade         Grade?          @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  subject       Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  users         User[]
  skillSequence SkillSequence[]

  @@index([type])
  @@index([isAutonomous])
  @@index([subjectId])
}

model User {
  id               String           @id
  email            String           @unique
  password         String?
  fullName         String
  gradeId          String
  learningPathId   String?
  selectedPathType LearningPathType @default(GRADE)
  learningStyle    String           @default("visual")
  language         String           @default("es")
  authProvider     String           @default("email")
  knowledgeState   Json?
  totalXP          Int              @default(0)
  currentLevel     Int              @default(1)
  currentStreak    Int              @default(0)
  role             UserRole         @default(STUDENT)
  gradeLockEnabled Boolean          @default(true)
  lastActivityAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  grade              Grade               @relation(fields: [gradeId], references: [id])
  learningPath       LearningPath?       @relation(fields: [learningPathId], references: [id], onDelete: SetNull)
  skillProgress      UserSkillProgress[]
  lessonStates       UserLessonState[]
  problemAttempts    ProblemAttempt[]
  achievements       UserAchievement[]
  assignedTasks      AssignedTask[]
  pedagogicalEvents  PedagogicalEvent[]
  tutorConversations TutorConversation[]
  tutorInterventions TutorIntervention[]

  @@index([gradeId])
  @@index([selectedPathType])
  @@index([role])
}

model Subject {
  id          String   @id
  code        String   @unique
  name        String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  learningPaths LearningPath[]
}

model Skill {
  id               String @id
  code             String @unique
  name             String
  slug             String @unique
  description      String
  category         String
  domain           SkillDomain
  branch           String
  gradeId          String?
  lessonId         String?
  difficulty       Int
  estimatedHours   Float
  masteryThreshold Int     @default(70)
  pedagogicalFocus String?
  metadata         Json?

  grade                Grade?            @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  lesson               Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  modules              SkillModule[]
  problems             Problem[]
  userProgress         UserSkillProgress[]
  sequences            SkillSequence[]
  lessonLinks          LessonSkill[]
  outgoingDependencies SkillDependency[] @relation("SkillDependencyParent")
  incomingDependencies SkillDependency[] @relation("SkillDependencyChild")
  attempts             ProblemAttempt[]
  tutorConversations   TutorConversation[]
  tutorInterventions   TutorIntervention[]
  pedagogicalEvents    PedagogicalEvent[]
  assignedTasks        AssignedTask[]

  @@unique([slug, gradeId])
  @@index([category])
  @@index([domain])
  @@index([gradeId])
  @@index([difficulty])
}

model SkillDependency {
  id             String @id @default(cuid())
  parentSkillId  String
  childSkillId   String
  relationType   String @default("prerequisite")
  diagnosticHint String?
  weight         Int    @default(1)

  parentSkill Skill @relation("SkillDependencyParent", fields: [parentSkillId], references: [id], onDelete: Cascade)
  childSkill  Skill @relation("SkillDependencyChild", fields: [childSkillId], references: [id], onDelete: Cascade)

  @@unique([parentSkillId, childSkillId])
  @@index([childSkillId])
}

model LessonSkill {
  id       String @id @default(cuid())
  lessonId String
  skillId  String
  order    Int
  emphasis Int    @default(1)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([lessonId, skillId])
  @@unique([lessonId, order])
  @@index([skillId])
}

model SkillModule {
  id          String @id @default(cuid())
  skillId     String
  title       String
  description String
  order       Int

  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  problems Problem[]

  @@unique([skillId, order])
  @@index([skillId])
}

model SkillSequence {
  id             String @id @default(cuid())
  learningPathId String
  skillId        String
  lessonId       String?
  order          Int

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  lesson       Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@unique([learningPathId, order])
  @@unique([learningPathId, skillId])
  @@index([learningPathId])
}

model Problem {
  id             String        @id @default(cuid())
  skillId        String
  lessonId       String?
  moduleId       String?
  type           String
  difficulty     Int
  question       String
  expectedAnswer String
  hints          String[]
  solution       String?
  source         ProblemSource @default(SEEDED)
  contextTags    String[]
  metadata       Json?
  createdAt      DateTime      @default(now())

  skill    Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  lesson   Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  module   SkillModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  attempts ProblemAttempt[]

  @@index([skillId])
  @@index([lessonId])
  @@index([moduleId])
  @@index([type])
}

model ProblemAttempt {
  id                 String           @id @default(cuid())
  userId             String
  problemId          String?
  skillId            String?
  lessonId           String?
  problemFingerprint String
  answer             String
  normalizedAnswer   String?
  isCorrect          Boolean
  attemptNumber      Int
  xpGained           Int
  timeTaken          Int
  learningPathType   LearningPathType @default(GRADE)
  tutorUsed          Boolean          @default(false)
  context            Json?
  createdAt          DateTime         @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem           Problem?           @relation(fields: [problemId], references: [id], onDelete: SetNull)
  skill             Skill?             @relation(fields: [skillId], references: [id], onDelete: SetNull)
  lesson            Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  pedagogicalEvents PedagogicalEvent[]

  @@index([userId])
  @@index([problemId])
  @@index([skillId])
  @@index([lessonId])
  @@index([createdAt])
  @@index([problemFingerprint])
}

model UserLessonState {
  id                 String       @id @default(cuid())
  userId             String
  lessonId           String
  status             LessonStatus @default(LOCKED)
  masteryPercentage  Int          @default(0)
  attemptsCount      Int          @default(0)
  unlockedAt         DateTime?
  lastProblemAt      DateTime?
  completedAt        DateTime?
  gradeGateSatisfied Boolean      @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([status])
}

model UserSkillProgress {
  id                  String   @id @default(cuid())
  userId              String
  skillId             String
  masteryPercentage   Int      @default(0)
  problemsSolved      Int      @default(0)
  problemsTotal       Int      @default(0)
  correctAttempts     Int      @default(0)
  incorrectAttempts   Int      @default(0)
  consecutiveFailures Int      @default(0)
  accuracy            Float    @default(0)
  startedAt           DateTime @default(now())
  lastPracticedAt     DateTime @updatedAt
  completedAt         DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([masteryPercentage])
  @@index([consecutiveFailures])
}

model Achievement {
  id          String @id @default(cuid())
  name        String @unique
  icon        String
  description String
  rarity      String
  condition   String

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model AssignedTask {
  id          String   @id @default(cuid())
  userId      String
  skillId     String
  lessonId    String?
  dueDate     DateTime
  difficulty  String
  rewardXP    Int
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill  Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([skillId])
  @@index([dueDate])
}

model PedagogicalEvent {
  id               String               @id @default(cuid())
  userId           String
  type             PedagogicalEventType
  problemAttemptId String?
  skillId          String?
  lessonId         String?
  payload          Json
  deliveryStatus   N8nDeliveryStatus    @default(PENDING)
  createdAt        DateTime             @default(now())
  processedAt      DateTime?

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemAttempt     ProblemAttempt?    @relation(fields: [problemAttemptId], references: [id], onDelete: SetNull)
  skill              Skill?             @relation(fields: [skillId], references: [id], onDelete: SetNull)
  lesson             Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  tutorInterventions TutorIntervention[]
  n8nDispatches      N8nDispatch[]

  @@index([userId, type])
  @@index([deliveryStatus])
  @@index([createdAt])
}

model TutorConversation {
  id                String                 @id @default(uuid())
  userId            String                 @map("student_id")
  problem           String
  studentAnswer     String                 @map("student_answer")
  attemptCount      Int                    @map("attempt_count")
  tutorResponse     String                 @map("tutor_response")
  pedagogicalFocus  String                 @map("pedagogical_focus")
  vibe              String
  provider          TutorProvider          @default(N8N)
  interventionLevel TutorInterventionLevel @default(SUBTLE) @map("intervention_level")
  skillId           String?
  lessonId          String?
  createdAt         DateTime               @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill  Skill?  @relation(fields: [skillId], references: [id], onDelete: SetNull)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("tutor_conversations")
}

model TutorIntervention {
  id                 String                 @id @default(cuid())
  userId             String
  skillId            String?
  lessonId           String?
  pedagogicalEventId String?
  provider           TutorProvider          @default(N8N)
  level              TutorInterventionLevel
  prompt             String
  response           String
  createdAt          DateTime               @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill            Skill?            @relation(fields: [skillId], references: [id], onDelete: SetNull)
  lesson           Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  pedagogicalEvent PedagogicalEvent? @relation(fields: [pedagogicalEventId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([pedagogicalEventId])
}

model N8nDispatch {
  id                 String            @id @default(cuid())
  pedagogicalEventId String
  workflowKey        String
  endpoint           String
  status             N8nDeliveryStatus @default(PENDING)
  statusCode         Int?
  requestBody        Json
  responseBody       Json?
  errorMessage       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  pedagogicalEvent PedagogicalEvent @relation(fields: [pedagogicalEventId], references: [id], onDelete: Cascade)

  @@index([pedagogicalEventId])
  @@index([status])
}
